// Andes — Prisma schema
//
// Modelo de datos completo (Fase 1), según PROYECTO-ANDES.md §6 y el
// descubrimiento de VikRentCar (docs/wordpress-mapping.md).
//
// Convenciones: modelos en PascalCase (inglés), tablas/columnas en snake_case
// vía @@map/@map. Todo cambio de esquema va por migración (`prisma migrate dev`).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  admin
  empleado
}

enum VehicleStatus {
  available
  rented
  out_of_service
}

enum RentalOrigin {
  vikrentcar
  manual
}

enum RentalStatus {
  reserved
  active
  finished
  cancelled
  // Reserva placeholder que bloqueaba el auto para un service/arreglo; el
  // auto vuelve a "disponible" y esta reserva pasa a `cancelled` cuando se
  // marca "de vuelta en servicio". Ver MaintenanceLog.rentalId.
  out_of_service
}

/// Idioma de cara al cliente (acta, emails, firma). Ver src/lib/i18n.
enum Language {
  es
  en
}

enum InspectionType {
  handover // entrega
  return_ // devolución (`return` es palabra reservada en algunos contextos)
}

/// Resultado real del envío del acta por email (Resend no tira excepción
/// ante un error de la API — sin este registro, un envío rechazado quedaba
/// invisible tanto para el equipo como para el cliente).
enum ActaEmailStatus {
  sent
  failed
  skipped
}

enum MediaType {
  photo
  video
}

/// Vistas del croquis donde se marca un daño.
enum DamageView {
  top
  front
  rear
  left
  right
  interior
}

enum MaintenanceType {
  service
  repair
  expense
  note
}

/// Tipo de documento del cliente capturado en la entrega.
enum DocumentKind {
  license // licencia de conducir
  dni // documento de identidad
  passport // pasaporte
}

enum SyncResult {
  success
  partial
  error
}

/// Estado de un pedido de firma remota (el cliente firma en su teléfono).
enum SignatureRequestStatus {
  pending
  signed
  expired
  cancelled
}

/// Tipo de movimiento de Caja: cobro, pago, o deuda acumulada con un
/// proveedor (sin salida de plata todavía — ver `PaymentMethodOwnership.provider`).
enum CashMovementType {
  income // cobro
  expense // pago
  debt // deuda con un proveedor, sin origen (cuenta corriente)
}

/// Tipo de movimiento de Caja Fuerte: ingreso o retiro de efectivo físico.
enum SafeMovementType {
  deposit // ingreso
  withdrawal // retiro
}

/// A quién pertenece la cuenta de un medio de pago. Todo medio de pago debe
/// estar catalogado en uno de los tres — no hay estado "indiferente". Solo
/// `provider` habilita cuenta corriente (deuda acumulada, ver
/// `CashMovementType.debt` y `src/lib/providers.ts`) — un asociado usado de
/// paso no.
enum PaymentMethodOwnership {
  own // cuenta propia
  associate // cuenta ajena de un asociado (empleado/socio), usada de paso
  provider // cuenta ajena de un proveedor — habilita cuenta corriente
}

/// Dispositivo detectado por User-Agent al iniciar sesión.
enum LoginDevice {
  pc
  mobile
}

/// Moneda de un movimiento de Caja o Caja fuerte. Por defecto siempre pesos
/// argentinos — dólares es la excepción (ej. un ingreso de efectivo puntual
/// en USD). Sin conversión entre ambas: los totales se muestran separados
/// por moneda, nunca sumados entre sí (ver `src/lib/currency.ts`).
enum Currency {
  ars
  usd
}

/// Confiabilidad de un precio de competencia (ver CompetitorPriceCheck).
/// `verified` = revisado/confirmado a mano; `auto_found` = extraído solo con
/// confianza suficiente (selectores, o LLM con grounding verificado);
/// `needs_review` = extraído pero con dudas; `unavailable` = no se pudo
/// obtener (sitio caído, bloqueo, sin resultados) — nunca se inventa un precio.
enum CompetitorPriceStatus {
  verified
  auto_found
  needs_review
  unavailable
}

/// Quién disparó una corrida de precios de competencia.
enum CompetitorRunTrigger {
  manual
  cron
}

/// Sentido de un mensaje de WhatsApp respecto del negocio.
enum WhatsAppDirection {
  in // del cliente hacia Andes
  out // de Andes hacia el cliente
}

/// Tipo de adjunto multimedia de un mensaje de WhatsApp.
enum WhatsAppMediaKind {
  image
  audio
  video
  document
  sticker
}

// ---------------------------------------------------------------------------
// Usuarios y autenticación
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         UserRole  @default(empleado)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  lastSeenAt   DateTime? @map("last_seen_at")

  inspections                    Inspection[]
  rentalDocuments                RentalDocument[]
  signatureRequests              SignatureRequest[]
  reportedDamages                Damage[]                @relation("DamageReporter")
  repairedDamages                Damage[]                @relation("DamageRepairer")
  createdVehicleNotes            VehicleNote[]           @relation("VehicleNoteCreator")
  resolvedVehicleNotes           VehicleNote[]           @relation("VehicleNoteResolver")
  createdRentalNotes             RentalNote[]            @relation("RentalNoteCreator")
  resolvedRentalNotes            RentalNote[]            @relation("RentalNoteResolver")
  createdCashMovements           CashMovement[]          @relation("CashMovementCreator")
  deletedCashMovements           CashMovement[]          @relation("CashMovementDeleter")
  cashMovementEdits              CashMovementEdit[]      @relation("CashMovementEditor")
  resolvedGuarantees             CashMovement[]          @relation("GuaranteeResolver")
  createdSafeMovements           SafeMovement[]          @relation("SafeMovementCreator")
  deletedSafeMovements           SafeMovement[]          @relation("SafeMovementDeleter")
  safeMovementEdits              SafeMovementEdit[]      @relation("SafeMovementEditor")
  conditionSettingsEdits         ConditionSettingsEdit[]
  loginEvents                    LoginEvent[]
  passwordResetTokens            PasswordResetToken[]
  createdTasks                   Task[]                  @relation("TaskCreator")
  assignedTasks                  Task[]                  @relation("TaskAssignee")
  completedTasks                 Task[]                  @relation("TaskCompleter")
  assignedWhatsappConversations  WhatsAppConversation[]
  sentWhatsappMessages           WhatsAppMessage[]
  resolvedWhatsappBotEscalations WhatsAppBotEscalation[] @relation("WhatsAppBotEscalationResolver")
  rentalQuotes                   RentalQuote[]

  @@map("users")
}

/// Auditoría de inicios de sesión: fecha/hora y dispositivo (pc/celular)
/// detectado por User-Agent. Solo logins: con sesión JWT de 30 min rolling,
/// un logout pasivo no dispara ningún evento confiable.
model LoginEvent {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  device    LoginDevice
  userAgent String?     @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("login_events")
}

// Recuperar contraseña: token de un solo uso enviado por email. Se guarda
// hasheado (sha256) — el token en texto plano solo existe en el link del
// email, nunca en la base.
model PasswordResetToken {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Flota
// ---------------------------------------------------------------------------

model Vehicle {
  id                String        @id @default(cuid())
  plate             String        @unique // patente
  // Apodo interno para referirse al auto (ej. "El rojo", "Wagon 2"). Cuando
  // está cargado, pasa a ser la referencia principal del auto en toda la app
  // (reservas, calendario, caja, etc.), por delante de marca/modelo/patente.
  name              String?
  brand             String // marca
  model             String // modelo
  year              Int?
  color             String?
  currentKm         Int           @default(0) @map("current_km")
  status            VehicleStatus @default(available)
  nextServiceKm     Int?          @map("next_service_km")
  // Cantidad de líneas/octavos del tanque de este auto (4–16, default 8). El
  // nivel de nafta de cada inspección se mide 0..fuelLevels. Configurable por
  // unidad: distintos autos tienen distinta granularidad de aguja.
  fuelLevels        Int           @default(8) @map("fuel_levels")
  // Intervalo de service en km. Al registrar un service, el próximo se
  // reprograma a (km del service + intervalo). Alimenta las alertas.
  serviceIntervalKm Int?          @map("service_interval_km")
  photoUrl          String?       @map("photo_url")
  notes             String?
  // Camioneta vs auto: VikRentCar tiene dos precios distintos de "Opciones
  // del Vehículo" para el pack de km extra (uno para autos, otro más caro
  // para camionetas). Alimenta qué precio de referencia (`ConditionSettings
  // .kmPackPrice` vs `.kmPackPriceTruck`) se precarga en la entrega.
  isTruck           Boolean       @default(false) @map("is_truck")

  // Identificación y seguro (opcionales, se cargan a mano en la ficha).
  engineNumber          String? @map("engine_number") // número de motor
  chassisNumber         String? @map("chassis_number") // número de chasis
  insurancePolicyNumber String? @map("insurance_policy_number") // número de póliza
  insuranceCompany      String? @map("insurance_company") // empresa de seguro

  // Tarifa de referencia por 1 día (traída de VikRentCar: dispcost days=1 ×
  // ajuste de temporada vigente). La refresca la sincronización; varía según la
  // fecha/temporada. Ver docs/wordpress-mapping.md y src/lib/sync.
  dailyRate          Decimal?  @map("daily_rate") @db.Decimal(12, 2)
  dailyRateUpdatedAt DateTime? @map("daily_rate_updated_at")

  // Orden manual en la vista Calendario (menor = más arriba). Refleja la lista
  // "del más caro al más económico" de la agenda; se carga a mano por unidad.
  // Los autos sin orden (null) quedan al final, ordenados por marca/modelo.
  sortOrder Int? @map("sort_order")

  // Archivado: baja de la flota operativa sin borrar la ficha (histórico,
  // actas y daños se conservan — evidencia inmutable). Ortogonal a `status`:
  // un auto puede archivarse recién cuando deja de estar `rented`. Los autos
  // archivados se excluyen de dashboard, listados operativos, QR y pickers,
  // pero su perfil sigue accesible. Ver docs: baja de auto en VikRentCar.
  archivedAt DateTime? @map("archived_at")

  // Mapeo a la unidad de VikRentCar (idcar, carindex). Ver docs/wordpress-mapping.md.
  wpCarId    Int? @map("wp_car_id")
  wpCarIndex Int? @map("wp_car_index")

  // Categoría de mercado para comparar contra precios de la competencia (ej.
  // Económico/SUV). Independiente de PROD-03 (plantillas de condiciones
  // económicas por segmento, todavía sin decidir) — no unificar sin que medie
  // una decisión de producto nueva. Ver CompetitorCategory.
  competitorCategoryId String?             @map("competitor_category_id")
  competitorCategory   CompetitorCategory? @relation(fields: [competitorCategoryId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rentals         Rental[]
  inspections     Inspection[]
  damages         Damage[]
  maintenanceLogs MaintenanceLog[]
  teamNotes       VehicleNote[]
  tasks           Task[]
  gpsDevices      GpsDevice[]
  rentalQuotes    RentalQuote[]

  @@unique([wpCarId, wpCarIndex])
  @@map("vehicles")
}

// ---------------------------------------------------------------------------
// GPS de rastreo instalados en la flota: solo la asignación ACTUAL (qué auto
// tiene instalado cada dispositivo), sin historial de reasignaciones ni
// integración con ninguna plataforma externa (sin mapa, sin ubicación en
// vivo) — decisión del dueño. Alta y asignación las hace cualquier empleado
// (son ellos quienes gestionan los dispositivos); borrar el catálogo es
// admin-only. Un auto puede tener más de un GPS instalado (ej. uno de
// respaldo) — `vehicleId` ya no es único. Ver /gps.
// ---------------------------------------------------------------------------
model GpsDevice {
  id String @id @default(cuid())

  identifier String @unique // número de serie / IMEI del dispositivo

  vehicleId   String?   @map("vehicle_id")
  vehicle     Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  installedAt DateTime? @map("installed_at")

  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([vehicleId])
  @@map("gps_devices")
}

// ---------------------------------------------------------------------------
// Temporadas de ajuste de tarifa (`wp_vikrentcar_seasons`, solo porcentuales),
// espejadas tal cual desde VikRentCar en cada sync (se borra y se recrea
// entera — no hay id propio del lado de WP para upsert). Antes se calculaban
// y se descartaban (solo quedaba `Vehicle.dailyRate` con la tarifa de "hoy");
// ahora se persisten para poder marcar en el Calendario los días con un
// incremento vigente. Ver src/lib/sync/rates.ts y src/lib/calendar.ts.
// ---------------------------------------------------------------------------
model SeasonRate {
  id          String   @id @default(cuid())
  fromSeconds Int      @map("from_seconds") // "segundos dentro del año" (día del año − 1) × 86400
  toSeconds   Int      @map("to_seconds")
  year        Int? // null = recurrente todos los años
  diffPercent Decimal  @map("diff_percent") @db.Decimal(6, 2)
  carIds      Int[]    @map("car_ids") // wp_car_id de los modelos a los que aplica
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("season_rates")
}

// ---------------------------------------------------------------------------
// Notas del equipo sobre un vehículo (mensajería interna, no el campo `notes`
// libre de la ficha). Sirven para avisarse situaciones a tener en cuenta entre
// compañeros. Mientras no se resuelven, se marcan como "notificación" (círculo
// rojo) sobre la patente en el Calendario; al resolverse pasan al historial de
// la ficha del auto y dejan de alertar. Auditoría de quién la cargó y quién la
// resolvió.
// ---------------------------------------------------------------------------

model VehicleNote {
  id String @id @default(cuid())

  vehicleId String  @map("vehicle_id")
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  text String @db.Text

  // `*Name` son nombres congelados al momento del hecho (ver
  // Inspection.userName) — sobreviven a que se borre el usuario.
  createdById   String? @map("created_by_id")
  createdBy     User?   @relation("VehicleNoteCreator", fields: [createdById], references: [id])
  createdByName String  @map("created_by_name")

  resolvedById   String?   @map("resolved_by_id")
  resolvedBy     User?     @relation("VehicleNoteResolver", fields: [resolvedById], references: [id])
  resolvedByName String?   @map("resolved_by_name")
  resolvedAt     DateTime? @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([vehicleId])
  @@map("vehicle_notes")
}

// Misma lógica que VehicleNote, pero sobre una reserva/alquiler: avisos entre
// compañeros a tener en cuenta (ej. "el cliente pidió cambiar el horario de
// entrega"). Sin resolver, alerta en el listado de Alquileres y en la barra
// del Calendario; al resolverse pasa al historial del detalle del alquiler.
model RentalNote {
  id String @id @default(cuid())

  rentalId String @map("rental_id")
  rental   Rental @relation(fields: [rentalId], references: [id])

  text String @db.Text

  // `*Name` son nombres congelados al momento del hecho (ver
  // Inspection.userName) — sobreviven a que se borre el usuario.
  createdById   String? @map("created_by_id")
  createdBy     User?   @relation("RentalNoteCreator", fields: [createdById], references: [id])
  createdByName String  @map("created_by_name")

  resolvedById   String?   @map("resolved_by_id")
  resolvedBy     User?     @relation("RentalNoteResolver", fields: [resolvedById], references: [id])
  resolvedByName String?   @map("resolved_by_name")
  resolvedAt     DateTime? @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([rentalId])
  @@map("rental_notes")
}

// ---------------------------------------------------------------------------
// Alquileres
// ---------------------------------------------------------------------------

model Rental {
  id String @id @default(cuid())

  // Nullable a propósito: una reserva de VikRentCar puede llegar sin unidad
  // asignada (carindex NULL) → "reserva sin vehículo asignado".
  vehicleId String?  @map("vehicle_id")
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  // Datos del cliente (denormalizados: el alquiler es la fuente de verdad del
  // contrato, independiente de cambios posteriores en VikRentCar).
  clientName      String    @map("client_name")
  clientEmail     String?   @map("client_email")
  clientPhone     String?   @map("client_phone")
  clientDocNumber String?   @map("client_doc_number") // nro. de documento opcional
  clientCountry   String?   @map("client_country") // país del cliente (VikRentCar orders.country, ~24%)
  clientAddress   String?   @map("client_address") // domicilio en Mendoza
  // Marca de que el empleado editó los datos del cliente a mano. A partir de ahí
  // el sync NO vuelve a pisar nombre/email/teléfono/documento (VikRentCar deja de
  // ser la fuente de verdad de esos campos para esta reserva).
  clientEditedAt  DateTime? @map("client_edited_at")
  licenseExpiry   DateTime? @map("license_expiry") // vencimiento licencia de conducir

  // Conductores adicionales autorizados (además del titular). Array JSON
  // [{ name }]; sus fotos de licencia se guardan como RentalDocument con
  // holderName. Los nombres figuran en el acta como conductores autorizados.
  additionalDrivers Json? @map("additional_drivers")

  startAt DateTime @map("start_at") // fecha/hora de retiro (UTC)
  endAt   DateTime @map("end_at") // fecha/hora de devolución (UTC)

  // Condiciones económicas del contrato (registro, sin cobro). Ver ContractPricing.
  pricing Json? @map("pricing")

  // Datos económicos importados de VikRentCar (referencia; el empleado los usa
  // para precargar/confirmar las condiciones). Ver docs/wordpress-mapping.md:
  // `days` 100%, `custdata` 100% (texto libre), `order_total` ~95%, `car_cost` ~24%.
  bookingCreatedAt          DateTime? @map("booking_created_at") // ts: cuándo se cargó la reserva en VikRentCar
  bookingDays               Int?      @map("booking_days") // days de la orden
  bookingPricePerDay        Decimal?  @map("booking_price_per_day") @db.Decimal(12, 2) // car_cost/days (si viene)
  bookingTotal              Decimal?  @map("booking_total") @db.Decimal(12, 2) // order_total (con extras)
  bookingPaid               Decimal?  @map("booking_paid") @db.Decimal(12, 2) // totpaid: pagado/anticipo de la reserva (precarga "Seña")
  bookingNote               String?   @map("booking_note") @db.Text // custdata: info de la reserva (staff)
  // Modelo de VikRentCar (cars.name vía idcar): se muestra cuando la reserva
  // llegó sin unidad física asignada (carindex NULL).
  bookingModel              String?   @map("booking_model")
  bookingPickupPlace        String?   @map("booking_pickup_place") // idplace → places.name
  bookingReturnPlace        String?   @map("booking_return_place") // idreturnplace → places.name
  // Opcionales de VikRentCar (wp_vikrentcar_optionals). Los packs de km → accesorios
  // (descripción + importe precalculado); la "Mejora de Seguro" → flag que baja la
  // franquicia. Precargan las condiciones; el sync nunca pisa `pricing`.
  bookingAccessories        String?   @map("booking_accessories") @db.Text
  bookingAccessoriesAmount  Decimal?  @map("booking_accessories_amount") @db.Decimal(12, 2)
  bookingInsuranceUpgrade   Boolean   @default(false) @map("booking_insurance_upgrade")
  // Método de pago de VikRentCar (orders.idpayment, ej. "Transferencia de Banco",
  // "Stripe", "Mercado Pago"). Solo el nombre; el `paymentlog` (datos de tarjeta)
  // NO se importa. ~25% de cobertura.
  bookingPaymentMethod      String?   @map("booking_payment_method")
  // Cuánto de `bookingPaid` ya se importó como ingreso a Caja (ver
  // `importBookingPayment` en booking-upsert.ts): permite importar solo la
  // diferencia si `totpaid` sigue creciendo entre corridas, sin duplicar.
  bookingPaidImportedAmount Decimal?  @map("booking_paid_imported_amount") @db.Decimal(12, 2)

  // ¿La reserva está confirmada en VikRentCar? Las `standby` entran sin confirmar
  // (bookingConfirmed=false) y se marcan en naranja; el sync la pasa a true si el
  // dueño la confirma. Los alquileres manuales nacen confirmados (default true).
  bookingConfirmed Boolean @default(true) @map("booking_confirmed")

  origin      RentalOrigin @default(manual)
  wpBookingId Int?         @unique @map("wp_booking_id") // id de la orden VikRentCar
  language    Language     @default(es)
  status      RentalStatus @default(reserved)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  inspections           Inspection[]
  documents             RentalDocument[]
  signatureRequests     SignatureRequest[]
  teamNotes             RentalNote[]
  cashMovements         CashMovement[]
  maintenanceLogs       MaintenanceLog[]
  whatsAppConversations WhatsAppConversation[]

  @@index([status])
  @@index([startAt])
  @@index([endAt]) // devoluciones de hoy / vencidas (dashboard)
  @@index([origin]) // conteos y filtros del sync
  @@index([vehicleId]) // alquileres por vehículo, reservas sin unidad
  @@map("rentals")
}

// Presupuesto/borrador sobre el Calendario: alguien del equipo está
// cotizando un auto para un rango de fechas y quiere que se vea (para que no
// se pise con un compañero) y que calcule el total. NO es una reserva real:
// no bloquea el auto, no aparece en Reportes/Dashboard/Caja/listado de
// Alquileres, y no se convierte solo en un `Rental` — cuando el cliente
// confirma, se sigue cargando el alquiler manual como siempre. Entidad
// separada a propósito (en vez de un status nuevo en `RentalStatus`) para no
// tener que auditar y excluir un status "borrador" en todos los lugares que
// hoy leen `Rental` sin filtrar.
model RentalQuote {
  id String @id @default(cuid())

  vehicleId String  @map("vehicle_id")
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  startAt DateTime @map("start_at") // medianoche Mendoza del día de inicio
  endAt   DateTime @map("end_at") // medianoche Mendoza del día siguiente al de fin (exclusivo, mismo criterio que Rental.endAt)

  clientName String? @map("client_name")
  note       String? @db.Text

  // Sugerido al crear (Vehicle.dailyRate × días), editable a mano — no se
  // recalcula solo si después cambia la tarifa del auto.
  estimatedTotal Decimal? @map("estimated_total") @db.Decimal(12, 2)

  conversationId String?               @map("conversation_id")
  conversation   WhatsAppConversation? @relation(fields: [conversationId], references: [id])

  // `createdByName` congela el nombre al momento del hecho (ver
  // Inspection.userName) — sobrevive a que se borre el usuario.
  createdById   String? @map("created_by_id")
  createdBy     User?   @relation(fields: [createdById], references: [id])
  createdByName String? @map("created_by_name")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([vehicleId])
  @@index([startAt])
  @@index([endAt])
  @@index([conversationId])
  @@map("rental_quotes")
}

// ---------------------------------------------------------------------------
// Documentos del cliente (licencia/DNI/pasaporte) — SOLO INTERNO
// ---------------------------------------------------------------------------
//
// Capturados opcionalmente en la entrega. Dato sensible: se guardan en R2
// (bucket privado) y se sirven únicamente por /api/media con sesión. NO se
// embeben en el acta ni se envían por email. Varias filas por alquiler
// (frente/dorso, etc.).
model RentalDocument {
  id String @id @default(cuid())

  rentalId String @map("rental_id")
  rental   Rental @relation(fields: [rentalId], references: [id])

  kind DocumentKind
  url  String // clave en R2 (bucket privado)

  // Nombre del titular del documento cuando pertenece a un conductor adicional
  // (no al cliente principal). Null = documento del titular del alquiler.
  holderName String? @map("holder_name")

  // Empleado que lo cargó (auditoría). Nullable por robustez.
  uploadedById String? @map("uploaded_by_id")
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id])

  capturedAt DateTime @default(now()) @map("captured_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([rentalId])
  @@map("rental_documents")
}

// ---------------------------------------------------------------------------
// Firma remota (el cliente firma en su propio teléfono escaneando un QR)
// ---------------------------------------------------------------------------
//
// El empleado, en el paso "Firma" del wizard, genera un pedido y muestra un QR
// en su pantalla. El cliente lo escanea, abre la página pública /sign/[id] (sin
// sesión, id no adivinable, con expiración y de un solo uso), ve el resumen y
// firma. El wizard poolea el estado y, al detectar `signed`, toma la firma.
model SignatureRequest {
  id String @id @default(cuid())

  // Borrador del wizard: la firma se guarda bajo la misma clave que espera el
  // guardado (uploads/{draftId}/signature.png).
  draftId String @map("draft_id")

  rentalId String @map("rental_id")
  rental   Rental @relation(fields: [rentalId], references: [id])

  type     InspectionType
  language Language       @default(es)

  // Snapshot del resumen para mostrarle al cliente qué está firmando.
  summary Json?

  signerName   String?                @map("signer_name")
  signatureKey String?                @map("signature_key")
  status       SignatureRequestStatus @default(pending)

  createdById String? @map("created_by_id")
  createdBy   User?   @relation(fields: [createdById], references: [id])

  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([rentalId])
  @@map("signature_requests")
}

// ---------------------------------------------------------------------------
// Inspecciones (entrega / devolución) — INMUTABLES una vez firmadas
// ---------------------------------------------------------------------------

model Inspection {
  id   String         @id @default(cuid())
  type InspectionType

  rentalId String @map("rental_id")
  rental   Rental @relation(fields: [rentalId], references: [id])

  vehicleId String  @map("vehicle_id")
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  // Empleado que la realizó (auditoría). `userId` es opcional (a diferencia
  // del resto del modelo, que es legalmente inmutable) para poder borrar al
  // usuario más adelante sin romper la inspección firmada — `userName` es el
  // nombre congelado al momento de firmar, que sigue mostrándose igual.
  userId   String? @map("user_id")
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName String  @map("user_name")

  km        Int
  fuelLevel Int @map("fuel_level") // octavos de tanque, 0–8

  // Respuestas del checklist configurable, como JSON { itemId: value }.
  checklistResponses Json?   @map("checklist_responses")
  observations       String?

  signatureUrl String? @map("signature_url") // firma del cliente (R2)
  signerName   String? @map("signer_name")

  // Liquidación de la devolución (solo en return_): excedente de km, nafta
  // faltante y cargos por daño nuevo contra el depósito. Ver src/lib/settlement.
  // Inmutable: es parte de lo que el cliente firma. Sin cobro.
  settlement Json? @map("settlement")

  // Geolocalización opcional (si el dispositivo dio permiso).
  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now()) @map("created_at")

  // "Avanzar sin señal": si al confirmar la entrega/devolución había fotos,
  // firma o documentos todavía sin subir, acá queda el manifiesto ESTÁTICO de
  // qué se esperaba (nunca se edita — ver `attachInspectionEvidence`, que
  // resuelve cada ítem comparando contra signatureUrl/media/damages/
  // documentos reales, no mutando esta lista). Null/vacío = ya estaba toda la
  // evidencia subida al guardar (el caso de siempre).
  pendingEvidence     Json?     @map("pending_evidence")
  // Se completa una única vez, cuando el último ítem pendiente termina de
  // subirse — recién ahí se dispara el acta+email demorados. `updateMany`
  // con `evidenceCompletedAt: null` como guard hace que solo un llamado
  // concurrente gane la carrera de completarlo.
  evidenceCompletedAt DateTime? @map("evidence_completed_at")

  // Estado del último intento de envío del acta por email, cliente y admin
  // por separado (uno puede fallar sin afectar al otro — ver
  // `generateAndSendActa`). Null = todavía no se intentó (evidencia pendiente
  // de subir) o la inspección es anterior a este seguimiento.
  actaClientEmailStatus ActaEmailStatus? @map("acta_client_email_status")
  actaClientEmailError  String?          @map("acta_client_email_error")
  actaClientEmailSentAt DateTime?        @map("acta_client_email_sent_at")
  actaAdminEmailStatus  ActaEmailStatus? @map("acta_admin_email_status")
  actaAdminEmailError   String?          @map("acta_admin_email_error")
  actaAdminEmailSentAt  DateTime?        @map("acta_admin_email_sent_at")

  media   InspectionMedia[]
  damages Damage[]

  // A lo sumo una entrega y una devolución por alquiler. Es la defensa real
  // contra la carrera de guardar dos veces (dos empleados, doble-tap, reintento
  // automático de la cola offline): como `saveHandover`/`saveReturn` crean la
  // inspección como primer paso de la transacción, un segundo intento
  // concurrente choca acá y hace rollback de todo (acta, cobro en Caja,
  // cambio de estado) antes de duplicar nada.
  @@unique([rentalId, type])
  @@index([rentalId])
  @@index([vehicleId])
  @@map("inspections")
}

model InspectionMedia {
  id String @id @default(cuid())

  inspectionId String     @map("inspection_id")
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  type       MediaType
  url        String
  capturedAt DateTime  @map("captured_at") // fecha/hora de captura

  createdAt DateTime @default(now()) @map("created_at")

  @@index([inspectionId])
  @@map("inspection_media")
}

// ---------------------------------------------------------------------------
// Daños (sobre el croquis del vehículo)
// ---------------------------------------------------------------------------

model Damage {
  id String @id @default(cuid())

  vehicleId String  @map("vehicle_id")
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  // Inspección donde se detectó. Nullable: los daños migrados en el seed
  // inicial no provienen de una inspección de Andes.
  inspectionId String?     @map("inspection_id")
  inspection   Inspection? @relation(fields: [inspectionId], references: [id])

  view        DamageView @default(top)
  posX        Float      @map("pos_x") // posición en el croquis (0–1)
  posY        Float      @map("pos_y")
  description String?
  photoUrl    String?    @map("photo_url")
  repaired    Boolean    @default(false)

  // Auditoría: quién cargó el daño (createdAt = fecha de carga) y, si se reparó,
  // quién lo marcó reparado y cuándo. Nullable por robustez (daños del seed).
  // `*Name` son nombres congelados al momento del hecho (ver
  // Inspection.userName) — sobreviven a que se borre el usuario.
  reportedById   String?   @map("reported_by_id")
  reportedBy     User?     @relation("DamageReporter", fields: [reportedById], references: [id])
  reportedByName String?   @map("reported_by_name")
  repairedById   String?   @map("repaired_by_id")
  repairedBy     User?     @relation("DamageRepairer", fields: [repairedById], references: [id])
  repairedByName String?   @map("repaired_by_name")
  repairedAt     DateTime? @map("repaired_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([vehicleId])
  @@index([inspectionId])
  @@map("damages")
}

// ---------------------------------------------------------------------------
// Mantenimiento
// ---------------------------------------------------------------------------

model MaintenanceLog {
  id String @id @default(cuid())

  vehicleId String  @map("vehicle_id")
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  // Reserva placeholder que bloqueaba el auto (VikRentCar) cuando este
  // registro se creó desde "Marcar service/arreglo" en el detalle de una
  // reserva. Null para los cargados directo desde la ficha del vehículo.
  rentalId String? @map("rental_id")
  rental   Rental? @relation(fields: [rentalId], references: [id])

  type        MaintenanceType
  date        DateTime
  km          Int?
  cost        Decimal?        @db.Decimal(12, 2)
  place       String? // taller / lugar donde se hizo el service o arreglo
  description String

  createdAt DateTime @default(now()) @map("created_at")

  @@index([vehicleId])
  @@index([rentalId])
  @@map("maintenance_logs")
}

// ---------------------------------------------------------------------------
// Tareas
// ---------------------------------------------------------------------------

enum TaskStatus {
  pending
  done
}

enum TaskPriority {
  normal
  high
}

/// Coordinación de trabajo del equipo (lavar un auto, hacer un trámite,
/// comprar algo): cualquiera crea una tarea, opcionalmente la asigna a otro
/// usuario y/o a un vehículo, con fecha opcional. Cualquiera puede marcarla
/// hecha (mismo criterio que "Resolver" en VehicleNote/RentalNote); solo
/// quien la creó o un admin puede editarla/borrarla. No es evidencia legal
/// como las inspecciones, así que no hace falta soft-delete ni auditoría de
/// ediciones (a diferencia de CashMovement).
model Task {
  id String @id @default(cuid())

  text     String       @db.Text
  priority TaskPriority @default(normal)
  status   TaskStatus   @default(pending)
  dueDate  DateTime?    @map("due_date")

  vehicleId String?  @map("vehicle_id")
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  // `*Name` son nombres congelados al momento del hecho (ver
  // Inspection.userName) — sobreviven a que se borre el usuario.
  assignedToId   String? @map("assigned_to_id")
  assignedTo     User?   @relation("TaskAssignee", fields: [assignedToId], references: [id])
  assignedToName String? @map("assigned_to_name")

  createdById   String? @map("created_by_id")
  createdBy     User?   @relation("TaskCreator", fields: [createdById], references: [id])
  createdByName String  @map("created_by_name")

  completedById String?   @map("completed_by_id")
  completedBy   User?     @relation("TaskCompleter", fields: [completedById], references: [id])
  completedAt   DateTime? @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([status])
  @@index([assignedToId])
  @@index([dueDate])
  @@index([vehicleId])
  @@map("tasks")
}

// ---------------------------------------------------------------------------
// Configuración del checklist
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Medios de pago (lista configurable, admin)
// ---------------------------------------------------------------------------
//
// Cada uno puede tener un % de ajuste (positivo = recargo, negativo =
// descuento) y una referencia interna (alias/CVU) que se muestra al empleado
// al agregar el pago en la entrega — nunca se imprime en el acta.
model PaymentMethod {
  id                String                 @id @default(cuid())
  name              String
  adjustmentPercent Decimal?               @map("adjustment_percent") @db.Decimal(6, 2)
  reference         String?                @map("reference") @db.Text
  // Si está activo, al elegir este medio (entrega o Caja) se pide un texto
  // libre obligatorio ("¿A dónde fue?") — pensado para un medio catch-all
  // como "Otro", para pagos que no encajan en ningún medio ya configurado.
  requiresNote      Boolean                @default(false) @map("requires_note")
  // Cuenta propia (de la empresa) o ajena (proveedor/empleado). Obligatorio:
  // todo medio de pago tiene que estar catalogado como uno u otro.
  ownership         PaymentMethodOwnership @default(own) @map("ownership")
  // Representa efectivo físico en mano (no en la caja fuerte todavía) — de
  // los movimientos de Caja con este medio sale el saldo de "Billetera"
  // (ver `getWalletBalance` en cash.ts). Normalmente uno solo ("Efectivo").
  isCash            Boolean                @default(false) @map("is_cash")
  ordering          Int                    @default(0)
  active            Boolean                @default(true)

  // Teléfono de WhatsApp de este proveedor/asociado (contacto frecuente) —
  // para mostrar un link directo a esa conversación desde su tarjeta en
  // Caja, sin tener que buscarla a mano en /whatsapp. Cruce best-effort por
  // teléfono contra WhatsAppConversation, igual que Rental↔Customer (no hay
  // FK — el número se tipea a mano acá y puede no coincidir exacto).
  whatsappPhone String? @map("whatsapp_phone")

  // Misma entidad (persona/proveedor) con más de una cuenta real (ej. efectivo
  // y transferencia) — la subcuenta apunta a la principal. Jerarquía de un
  // solo nivel a propósito (una subcuenta no puede tener sus propias
  // subcuentas; se valida en `updatePaymentMethods`). Cada cuenta sigue
  // pudiéndose elegir individualmente al cargar un pago (para saber por qué
  // rail salió/entró la plata) — lo único que se agrupa son los cálculos
  // (saldo de cuenta corriente, "Total entregado", ver `src/lib/providers.ts`
  // y `CashMovementsBoard`). Si se borra la principal, sus subcuentas quedan
  // sueltas (vuelven a ser principales) en vez de arrastrarse.
  parentId    String?         @map("parent_id")
  parent      PaymentMethod?  @relation("PaymentMethodSubaccounts", fields: [parentId], references: [id], onDelete: SetNull)
  subaccounts PaymentMethod[] @relation("PaymentMethodSubaccounts")

  // Comisión que cobra esta cuenta por cada ingreso (ej. tarjeta, pasarela):
  // porcentaje del monto y/o monto fijo (este último solo en pesos). Cada
  // ingreso en esta cuenta genera solo un egreso por la comisión, de la misma
  // cuenta, con la categoría indicada — ver `src/lib/commissions-sync.ts`. No
  // aplica a garantías ni es retroactivo (solo ingresos cargados/editados
  // después de configurarla).
  commissionPercent    Decimal?              @map("commission_percent") @db.Decimal(6, 2)
  commissionFixed      Decimal?              @map("commission_fixed") @db.Decimal(12, 2)
  commissionCategoryId String?               @map("commission_category_id")
  commissionCategory   CashMovementCategory? @relation("CommissionCategory", fields: [commissionCategoryId], references: [id], onDelete: SetNull)

  // Corrección manual del saldo calculado de una cuenta propia (ej. alinear
  // Andes contra el saldo real de una cuenta al darla de alta acá, cuando ya
  // venía operando con movimientos previos que no están cargados). Se suma
  // directo al saldo mostrado (`getOwnAccountBalances`) — a propósito NO es un
  // `CashMovement`: no genera un ingreso/egreso ni queda en ningún historial,
  // solo "ordena" el número. Solo tiene sentido en cuentas `own`.
  balanceAdjustmentArs Decimal @default(0) @map("balance_adjustment_ars") @db.Decimal(14, 2)
  balanceAdjustmentUsd Decimal @default(0) @map("balance_adjustment_usd") @db.Decimal(14, 2)

  transfersOut AccountTransfer[] @relation("AccountTransferFrom")
  transfersIn  AccountTransfer[] @relation("AccountTransferTo")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cashMovements            CashMovement[]    @relation("CashMovementMethod")
  cashMovementsAsRecipient CashMovement[]    @relation("CashMovementRecipient")
  // Nombres de medio de pago de VikRentCar que corresponden a este medio de
  // Andes (ver WpPaymentMethod). Puede haber más de un medio de Andes por
  // nombre de VikRentCar: el sync solo auto-resuelve cuando hay exactamente uno.
  wpPaymentMethods         WpPaymentMethod[] @relation("WpPaymentMethodMapping")

  @@index([parentId])
  @@map("payment_methods")
}

/// Catálogo de nombres de método de pago vistos en VikRentCar (`orders.idpayment`,
/// ej. "Stripe", "Transferencia de Banco"). No hay una tabla fija de gateways en
/// WordPress: se completa solo, a medida que el sync ve nombres reales en las
/// reservas. El admin asocia cada nombre a uno o más medios de pago de Andes
/// (Configuración → Medios de pago); cuando la asociación es a un único medio,
/// el sync lo usa para confirmar solo el ingreso importado (ver `booking-upsert.ts`).
model WpPaymentMethod {
  id   String @id @default(cuid())
  name String @unique

  paymentMethods PaymentMethod[] @relation("WpPaymentMethodMapping")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("wp_payment_methods")
}

// ---------------------------------------------------------------------------
// Caja (movimientos de cobro/pago)
// ---------------------------------------------------------------------------
//
// Cualquier rol puede cargar cobros y pagos; solo el admin ve el detalle
// completo por mes. Vínculo opcional a una reserva. El medio de pago se
// guarda como snapshot (id + nombre): si el medio cambia de nombre o se
// borra después, el movimiento ya cargado no se ve afectado (mismo criterio
// que RentalPayment en src/lib/contract.ts).
//
// En un Pago, `paymentMethod` es el Origen (cuenta propia de la que sale la
// plata, obligatorio) y `recipientPaymentMethod` es el Destino (cuenta ajena
// a la que se le paga, opcional — no todo pago tiene una cuenta ajena
// puntual). En un Cobro solo se usa `paymentMethod` ("Medio de pago"), sin
// distinción de origen/destino.
//
// Editable/eliminable SOLO por admin (para corregir errores de carga) — el
// borrado es soft-delete (`deletedAt`), nunca se borra la fila realmente.
// Cada edición/borrado queda registrado en CashMovementEdit.
model CashMovement {
  id String @id @default(cuid())

  type        CashMovementType
  description String           @db.Text
  amount      Decimal          @db.Decimal(12, 2)
  currency    Currency         @default(ars)

  paymentMethodId   String?        @map("payment_method_id")
  paymentMethod     PaymentMethod? @relation("CashMovementMethod", fields: [paymentMethodId], references: [id])
  paymentMethodName String         @map("payment_method_name")
  // Aclaración libre cuando el medio elegido tenía `requiresNote` (ej. "Otro").
  paymentMethodNote String?        @map("payment_method_note") @db.Text

  recipientPaymentMethodId   String?        @map("recipient_payment_method_id")
  recipientPaymentMethod     PaymentMethod? @relation("CashMovementRecipient", fields: [recipientPaymentMethodId], references: [id])
  recipientPaymentMethodName String?        @map("recipient_payment_method_name")
  recipientPaymentMethodNote String?        @map("recipient_payment_method_note") @db.Text

  // Categorización opcional de un Egreso (ej. Combustible, Mantenimiento,
  // Sueldos) — nunca se usa en Ingresos. Mismo patrón de snapshot que
  // `paymentMethodName`: `categoryName` queda fijo aunque la categoría se
  // renombre o se borre después, para que el movimiento ya cargado no cambie.
  categoryId   String?               @map("category_id")
  category     CashMovementCategory? @relation(fields: [categoryId], references: [id])
  categoryName String?               @map("category_name")

  rentalId String? @map("rental_id")
  rental   Rental? @relation(fields: [rentalId], references: [id])

  // true = importado automático desde VikRentCar sin poder resolver a qué
  // medio de pago de Andes corresponde (nombre desconocido, o mapeado a más
  // de uno) — falta que alguien confirme el medio real (cualquier usuario,
  // ver `confirmCashMovementPaymentMethod`).
  needsConfirmation Boolean @default(false) @map("needs_confirmation")

  // true = este movimiento es-o-viene-de una garantía/depósito (ver
  // `RentalPayment.isGuarantee` en contract.ts): se excluye de Movimientos/
  // Saldos/Billetera/búsqueda (findMovements en cash.ts) y vive aparte en la
  // pestaña Garantías — no es un cobro/pago real del negocio, es plata que
  // hay que devolver (o, si se cobra, recién ahí pasa a serlo — ver abajo).
  isGuarantee Boolean @default(false) @map("is_guarantee")

  // --- Ciclo de vida de una garantía (solo se usan en la fila que la tomó,
  // es decir `type: income, isGuarantee: true` — esa fila ES la garantía,
  // no hace falta una tabla aparte). `guaranteeResolvedAt` nulo = activa.
  // Al resolver (Devolver o Cobrar, ver `caja/guarantee-actions.ts`) se
  // completa una sola vez y nunca se vuelve a tocar — mismo criterio de
  // inmutabilidad que el resto de los hechos ya registrados en Caja.
  guaranteeResolvedAt     DateTime? @map("guarantee_resolved_at")
  // Cuánto de la garantía se cobró (pasó a ser ingreso real) vs. se devolvió
  // — ambos pueden ser >0 a la vez (cobro parcial + devolución del resto).
  guaranteeChargedAmount  Decimal?  @map("guarantee_charged_amount") @db.Decimal(12, 2)
  guaranteeReturnedAmount Decimal?  @map("guarantee_returned_amount") @db.Decimal(12, 2)
  guaranteeResolvedById   String?   @map("guarantee_resolved_by_id")
  guaranteeResolvedBy     User?     @relation("GuaranteeResolver", fields: [guaranteeResolvedById], references: [id])
  guaranteeResolvedByName String?   @map("guarantee_resolved_by_name")

  // En la fila que la tomó, esto queda null. En el/los movimiento(s) que
  // resolverla generó (el ingreso por lo cobrado, el egreso por lo
  // devuelto), apunta de vuelta a esa fila — así el historial de la
  // garantía puede mostrarlos (reutilizando `MovementRow`, editables como
  // cualquier otro movimiento) sin tener que adivinar cuáles son.
  // Egreso generado solo por la comisión de un ingreso (ver
  // `PaymentMethod.commissionPercent`): apunta al ingreso que lo originó, y se
  // recalcula/elimina junto con él. Null en cualquier otro movimiento.
  commissionSourceId String?        @map("commission_source_id")
  commissionSource   CashMovement?  @relation("CommissionDerivative", fields: [commissionSourceId], references: [id])
  commissionExpenses CashMovement[] @relation("CommissionDerivative")

  guaranteeSourceId String?          @map("guarantee_source_id")
  guaranteeSource   CashMovement?    @relation("GuaranteeDerivative", fields: [guaranteeSourceId], references: [id])
  guaranteeDerived  CashMovement[]   @relation("GuaranteeDerivative")

  // `*Name` son nombres congelados al momento del hecho (ver
  // Inspection.userName) — sobreviven a que se borre el usuario.
  createdById   String? @map("created_by_id")
  createdBy     User?   @relation("CashMovementCreator", fields: [createdById], references: [id])
  createdByName String? @map("created_by_name")

  // Soft delete: nunca se borra la fila, para que CashMovementEdit pueda
  // seguir mostrando qué era el movimiento eliminado.
  deletedAt     DateTime? @map("deleted_at")
  deletedById   String?   @map("deleted_by_id")
  deletedBy     User?     @relation("CashMovementDeleter", fields: [deletedById], references: [id])
  deletedByName String?   @map("deleted_by_name")

  createdAt DateTime @default(now()) @map("created_at")

  edits CashMovementEdit[]

  @@index([createdAt])
  @@index([rentalId])
  @@index([createdById])
  @@index([categoryId])
  @@index([guaranteeSourceId])
  @@index([commissionSourceId])
  @@map("cash_movements")
}

/// Catálogo editable (Configuración → Categorías de gasto) de categorías para
/// clasificar Egresos — mismo patrón que `ChecklistItem` (nombre + orden +
/// activo, CRUD simple). Solo se ofrece al cargar/editar un Egreso; un
/// Ingreso no se categoriza.
model CashMovementCategory {
  id       String  @id @default(cuid())
  name     String
  ordering Int     @default(0)
  active   Boolean @default(true)

  movements         CashMovement[]
  commissionMethods PaymentMethod[] @relation("CommissionCategory")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("cash_movement_categories")
}

/// Acción registrada en el historial de ediciones de un CashMovement.
enum CashMovementEditAction {
  updated
  deleted
}

/// Auditoría de ediciones/borrados de movimientos de Caja (solo admin puede
/// generar estas filas). `changes` solo se usa en `updated` — un array
/// [{ field, from, to }]; en `deleted` no hace falta: el propio CashMovement,
/// soft-deleted, ya conserva los datos.
model CashMovementEdit {
  id String @id @default(cuid())

  cashMovementId String       @map("cash_movement_id")
  cashMovement   CashMovement @relation(fields: [cashMovementId], references: [id])

  action  CashMovementEditAction
  changes Json?

  editedById   String? @map("edited_by_id")
  editedBy     User?   @relation("CashMovementEditor", fields: [editedById], references: [id])
  editedByName String? @map("edited_by_name")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([cashMovementId])
  @@index([createdAt])
  @@map("cash_movement_edits")
}

// ---------------------------------------------------------------------------
// Caja fuerte (ingresos/retiros de efectivo físico)
// ---------------------------------------------------------------------------
//
// Distinto de CashMovement: no es un cobro/pago del negocio ligado a un medio
// de pago o una reserva, es el movimiento de efectivo físico hacia/desde la
// caja fuerte. Cualquier rol puede cargar un ingreso o un retiro; el
// historial (fecha + quién) es visible para todos, pero el SALDO acumulado
// (histórico completo, no por mes — representa cuánto efectivo hay hoy
// guardado) solo lo ve el admin. Mismo patrón de auditoría que CashMovement:
// editable/eliminable solo por admin, soft-delete + SafeMovementEdit.
model SafeMovement {
  id String @id @default(cuid())

  type        SafeMovementType
  description String           @db.Text
  amount      Decimal          @db.Decimal(12, 2)
  currency    Currency         @default(ars)

  createdById   String? @map("created_by_id")
  createdBy     User?   @relation("SafeMovementCreator", fields: [createdById], references: [id])
  createdByName String? @map("created_by_name")

  deletedAt     DateTime? @map("deleted_at")
  deletedById   String?   @map("deleted_by_id")
  deletedBy     User?     @relation("SafeMovementDeleter", fields: [deletedById], references: [id])
  deletedByName String?   @map("deleted_by_name")

  createdAt DateTime @default(now()) @map("created_at")

  edits SafeMovementEdit[]

  @@index([createdAt])
  @@index([createdById])
  @@map("safe_movements")
}

/// Acción registrada en el historial de ediciones de un SafeMovement.
enum SafeMovementEditAction {
  updated
  deleted
}

/// Auditoría de ediciones/borrados de movimientos de Caja Fuerte (solo admin).
model SafeMovementEdit {
  id String @id @default(cuid())

  safeMovementId String       @map("safe_movement_id")
  safeMovement   SafeMovement @relation(fields: [safeMovementId], references: [id])

  action  SafeMovementEditAction
  changes Json?

  editedById   String? @map("edited_by_id")
  editedBy     User?   @relation("SafeMovementEditor", fields: [editedById], references: [id])
  editedByName String? @map("edited_by_name")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([safeMovementId])
  @@index([createdAt])
  @@map("safe_movement_edits")
}

model ChecklistItem {
  id       String  @id @default(cuid())
  label    String // etiqueta mostrada al empleado (español)
  ordering Int     @default(0)
  active   Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("checklist_items")
}

// ---------------------------------------------------------------------------
// Condiciones económicas precargadas (plantilla global, un solo registro)
// ---------------------------------------------------------------------------
//
// Valores por defecto que el empleado ve precargados en el paso "Condiciones"
// de la entrega y puede ajustar antes de firmar. Singleton: siempre id = 1.
// La "hora extra" se expresa como % de la tarifa diaria del alquiler.
//
// Límite conocido: al ser un singleton global, asume una sola sucursal/
// política económica para toda la flota. Si algún día hay más de una
// sucursal con condiciones propias, esto necesita pasar de `id: 1` fijo a
// una fila por sucursal (branchId) — no hay ningún atajo hoy para eso.
model ConditionSettings {
  id                       Int      @id @default(1)
  insuranceAmount          Decimal? @map("insurance_amount") @db.Decimal(12, 2) // seguro
  kmPerDay                 Int?     @map("km_per_day") // km incluidos por día
  extraKmRate              Decimal? @map("extra_km_rate") @db.Decimal(12, 2) // $ por km extra
  extraHourPercent         Int?     @map("extra_hour_percent") // % de la tarifa diaria por hora extra
  // Franquicia (deducible del seguro): la estándar y la reducida cuando el
  // alquiler lleva "Mejora de Seguro" (ej. 600.000 → 400.000).
  deductible               Decimal? @map("deductible") @db.Decimal(12, 2) // franquicia estándar
  deductibleReduced        Decimal? @map("deductible_reduced") @db.Decimal(12, 2) // franquicia con mejora de seguro
  // Pack de KM adicional (200 km c/u, de 1 a 20 packs por alquiler): precio de
  // referencia por pack, precargado en el paso "Condiciones" de la entrega.
  // Autos vs camionetas tienen precios distintos en VikRentCar (Opciones del
  // Vehículo) — `kmPackPrice` es el de autos (default), `kmPackPriceTruck` el
  // de camionetas; se precarga uno u otro según `Vehicle.isTruck`.
  kmPackPrice              Decimal? @map("km_pack_price") @db.Decimal(12, 2)
  kmPackPriceTruck         Decimal? @map("km_pack_price_truck") @db.Decimal(12, 2)
  // Envío del acta al cliente por email (el admin siempre la recibe). Apagar
  // para dejar de mandarle al cliente el acta de entrega o de devolución.
  sendHandoverActa         Boolean  @default(true) @map("send_handover_acta")
  sendReturnActa           Boolean  @default(true) @map("send_return_acta")
  // Alertas de service (dashboard): un auto vencido se muestra en ámbar
  // mientras el excedente sobre `nextServiceKm` no supere este % del
  // intervalo de service del auto; por encima, pasa a rojo. Null → default
  // 15 (ver DEFAULT_SERVICE_OVERDUE_RED_PERCENT en src/lib/service-alerts.ts).
  serviceOverdueRedPercent Int?     @map("service_overdue_red_percent")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("condition_settings")
}

// Auditoría de cambios en ConditionSettings (singleton, sin FK propia: no
// hace falta, solo hay una fila). Mismo shape de `changes` (FieldChange[])
// que CashMovementEdit/SafeMovementEdit — ver src/lib/movement-audit.ts.
model ConditionSettingsEdit {
  id String @id @default(cuid())

  changes Json // FieldChange[]

  // Nombre congelado al momento de la edición (ver Inspection.userName) —
  // permite borrar al usuario sin perder de vista quién hizo cada cambio.
  editedById   String? @map("edited_by_id")
  editedBy     User?   @relation(fields: [editedById], references: [id], onDelete: SetNull)
  editedByName String  @map("edited_by_name")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("condition_settings_edits")
}

// Textos editables de los correos transaccionales y casilla remitente.
// Singleton: siempre id = 1. Cada campo es un override opcional del diccionario
// i18n (src/lib/i18n/dictionaries.ts): si está vacío/null, se usa el texto por
// defecto del sistema. `fromAddress` pisa la env var EMAIL_FROM.
//
// Mismo límite de multi-sucursal que ConditionSettings (ver arriba): un solo
// remitente/texto para toda la app.
model EmailSettings {
  id          Int     @id @default(1)
  fromAddress String? @map("from_address") // casilla "desde" (pisa EMAIL_FROM)

  // Español
  esHandoverSubject String? @map("es_handover_subject")
  esReturnSubject   String? @map("es_return_subject")
  esGreeting        String? @map("es_greeting")
  esHandoverBody    String? @map("es_handover_body")
  esReturnBody      String? @map("es_return_body")
  esAttachmentNote  String? @map("es_attachment_note")
  esRegards         String? @map("es_regards")

  // Inglés
  enHandoverSubject String? @map("en_handover_subject")
  enReturnSubject   String? @map("en_return_subject")
  enGreeting        String? @map("en_greeting")
  enHandoverBody    String? @map("en_handover_body")
  enReturnBody      String? @map("en_return_body")
  enAttachmentNote  String? @map("en_attachment_note")
  enRegards         String? @map("en_regards")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("email_settings")
}

// ---------------------------------------------------------------------------
// Log de sincronización con VikRentCar
// ---------------------------------------------------------------------------

model SyncLog {
  id        String     @id @default(cuid())
  result    SyncResult
  imported  Int        @default(0)
  updated   Int        @default(0)
  errors    Int        @default(0)
  message   String?
  createdAt DateTime   @default(now()) @map("created_at")

  @@map("sync_logs")
}

// ---------------------------------------------------------------------------
// Precios de la competencia (rentadoras de Mendoza): scraping + LLM, con
// normalización de categorías e historial. Ver el plan de diseño para el
// contexto completo (modelo append-only + tabla de "actual" denormalizada,
// mismo patrón que Vehicle.dailyRate/SeasonRate).
// ---------------------------------------------------------------------------

/// Una rentadora competidora a trackear. `adapterKey` identifica qué módulo
/// de src/lib/competitor-prices/adapters la maneja (cada sitio tiene su
/// propio flujo/selectores — no es 100% genérico por config). `active=false`
/// saca al competidor de las corridas sin borrar su historial (ej. si no se
/// encuentra una fuente confiable, como puede pasar con Cactus).
model Competitor {
  id         String  @id @default(cuid())
  name       String
  url        String
  active     Boolean @default(true)
  adapterKey String  @map("adapter_key")
  config     Json? // parámetros propios del adaptador (sucursal, ids de formulario, etc.)
  notes      String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  categoryMappings CompetitorCategoryMapping[]
  priceChecks      CompetitorPriceCheck[]
  currentPrices    CompetitorCurrentPrice[]

  @@map("competitors")
}

/// Catálogo fijo de categorías de mercado para comparar contra la
/// competencia (Económico/Compacto/Intermedio/SUV/...). Independiente de
/// PROD-03 (plantillas de condiciones económicas por segmento, todavía sin
/// decidir) — comentario a propósito: no unificar sin que medie una
/// decisión de producto nueva, y por eso se evita la palabra "segmento" acá.
model CompetitorCategory {
  id       String @id @default(cuid())
  label    String @unique
  ordering Int    @default(0)

  suggestedInMappings CompetitorCategoryMapping[] @relation("CompetitorCategoryMappingSuggested")
  confirmedInMappings CompetitorCategoryMapping[] @relation("CompetitorCategoryMappingConfirmed")
  priceChecks         CompetitorPriceCheck[]
  currentPrices       CompetitorCurrentPrice[]
  vehicles            Vehicle[]

  @@map("competitor_categories")
}

/// Normalización: qué categoría interna corresponde a un rótulo crudo visto
/// en el sitio de un competidor (ej. "Corolla Sedan" → Intermedio). El LLM
/// propone `suggestedCategoryId` la primera vez que aparece un `rawLabel`
/// nuevo, pero `categoryId` (el que cuenta para la tabla comparativa) queda
/// null hasta que un humano lo confirma en la cola de revisión — es la
/// única pieza donde una clasificación mal hecha sesgaría todo en silencio,
/// y como los rawLabel nuevos son raros, exigir confirmación sale barato.
model CompetitorCategoryMapping {
  id String @id @default(cuid())

  competitorId String     @map("competitor_id")
  competitor   Competitor @relation(fields: [competitorId], references: [id])

  rawLabel String @map("raw_label")

  suggestedCategoryId String?             @map("suggested_category_id")
  suggestedCategory   CompetitorCategory? @relation("CompetitorCategoryMappingSuggested", fields: [suggestedCategoryId], references: [id])

  categoryId String?             @map("category_id")
  category   CompetitorCategory? @relation("CompetitorCategoryMappingConfirmed", fields: [categoryId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([competitorId, rawLabel])
  @@map("competitor_category_mappings")
}

/// Log histórico APPEND-ONLY de cada precio consultado (nunca se actualiza,
/// solo se inserta) — alimenta el detalle/tendencia. La tabla comparativa
/// NO lee de acá directo (ver CompetitorCurrentPrice); esto es el archivo.
/// `price`/`currency`/`status=unavailable` conviven: un intento fallido
/// igual queda registrado, con `errorReason`, para trazabilidad y alertas.
model CompetitorPriceCheck {
  id String @id @default(cuid())

  competitorId String     @map("competitor_id")
  competitor   Competitor @relation(fields: [competitorId], references: [id])

  // Categoría resuelta (null si el rawLabel todavía no está confirmado) +
  // el rótulo crudo tal cual vino de la fuente, para trazabilidad aunque el
  // mapeo cambie después.
  categoryId String?             @map("category_id")
  category   CompetitorCategory? @relation(fields: [categoryId], references: [id])
  rawLabel   String?             @map("raw_label")

  price    Decimal?  @db.Decimal(12, 2)
  currency Currency?

  checkedAt  DateTime @map("checked_at")
  // DateTime normal, NO @db.Date: son el instante UTC de la medianoche de
  // Mendoza (mendozaWallTimeToUtc), mismo patrón que Task.dueDate. Un
  // @db.Date acá trunca a la fecha calendario en UTC y, al mostrarla de
  // vuelta con un formateador Mendoza-aware, corre un día para atrás
  // (bug real encontrado y corregido: verificado con Playwright, "Retiro"
  // mostraba el día anterior a las 21:00).
  pickupDate DateTime @map("pickup_date")
  returnDate DateTime @map("return_date")
  days       Int

  includesTax       Boolean? @map("includes_tax")
  includesInsurance Boolean? @map("includes_insurance")
  conditionsNote    String?  @map("conditions_note") @db.Text

  sourceUrl String? @map("source_url") @db.Text

  status      CompetitorPriceStatus
  errorReason String?               @map("error_reason") @db.Text

  // String citado tal cual por el LLM (grounding: se verifica que aparezca
  // literal en el texto crudo antes de confiar en él) — para auditar qué
  // extrajo y por qué se descartó algo mientras se calibra el pipeline.
  // Null cuando el precio salió de selectores, sin pasar por el LLM.
  llmCitation String? @map("llm_citation") @db.Text

  runId String             @map("run_id")
  run   CompetitorCheckRun @relation(fields: [runId], references: [id])

  currentPriceRef CompetitorCurrentPrice?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([competitorId, categoryId, pickupDate])
  @@index([runId])
  @@map("competitor_price_checks")
}

/// Último precio válido por (competidor, categoría, ventana de fecha) —
/// tabla chica y denormalizada, la que lee la pantalla de comparación.
/// El orquestador hace upsert acá después de cada check exitoso; si el
/// check más reciente da `unavailable`, esta fila simplemente no se pisa
/// (el precio anterior sigue siendo el "último válido", solo se ve
/// desactualizado por `lastCheckedAt`).
model CompetitorCurrentPrice {
  id String @id @default(cuid())

  competitorId String     @map("competitor_id")
  competitor   Competitor @relation(fields: [competitorId], references: [id])

  categoryId String             @map("category_id")
  category   CompetitorCategory @relation(fields: [categoryId], references: [id])

  // Offset de días (0/30/60/...) desde el momento del check, no la fecha de
  // retiro en sí — así la celda de la comparación es estable sin importar
  // cuándo se corrió el check. Ver CompetitorPriceSettings.offsetsDays.
  pickupOffsetDays Int @map("pickup_offset_days")

  priceCheckId String               @unique @map("price_check_id")
  priceCheck   CompetitorPriceCheck @relation(fields: [priceCheckId], references: [id])

  lastCheckedAt DateTime @map("last_checked_at")

  @@unique([competitorId, categoryId, pickupOffsetDays])
  @@map("competitor_current_prices")
}

/// Una corrida de actualización de precios (mirror de SyncLog). `result`
/// null mientras está en curso (`finishedAt` también null) — sirve de guard
/// de concurrencia: no arrancar una corrida nueva si ya hay una sin
/// terminar.
model CompetitorCheckRun {
  id String @id @default(cuid())

  triggeredBy CompetitorRunTrigger @map("triggered_by")

  startedAt  DateTime    @map("started_at")
  finishedAt DateTime?   @map("finished_at")
  result     SyncResult? // reusa el mismo enum que SyncLog (success/partial/error)

  competitorsChecked Int     @default(0) @map("competitors_checked")
  pricesFound        Int     @default(0) @map("prices_found")
  errors             Int     @default(0)
  message            String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  priceChecks CompetitorPriceCheck[]

  @@map("competitor_check_runs")
}

/// Singleton (mismo patrón que ConditionSettings) — ventanas de fecha y
/// duración configurables sin tocar código. Default: hoy/+30/+60, 3 días.
model CompetitorPriceSettings {
  id                 Int      @id @default(1)
  offsetsDays        Int[]    @default([0, 30, 60]) @map("offsets_days")
  rentalDurationDays Int      @default(3) @map("rental_duration_days")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("competitor_price_settings")
}

// ---------------------------------------------------------------------------
// WhatsApp — mensajería con clientes vía Chakra (BSP → WhatsApp Cloud API)
// ---------------------------------------------------------------------------
//
// Single-tenant: no hay concepto de workspace, así que la cuenta conectada es
// un singleton (mismo patrón que ConditionSettings/EmailSettings) y el
// webhook no necesita resolver a qué "tenant" pertenece un evento entrante.

/// Credenciales de la cuenta de WhatsApp Business conectada vía Chakra.
/// Singleton id = 1. `accessTokenEnc`/`webhookSecretEnc` se guardan cifrados
/// (AES-256-GCM, ver src/lib/encryption.ts) — nunca en texto plano.
model WhatsAppSettings {
  id Int @id @default(1)

  provider String @default("chakra") // por si algún día se suma otro BSP

  wabaId        String @map("waba_id") // WhatsApp Business Account id (Meta)
  phoneNumberId String @map("phone_number_id") // Phone Number id (Meta)
  pluginId      String @map("plugin_id") // id propio de Chakra, necesario para enviar

  accessTokenEnc   String  @map("access_token_enc") @db.Text
  webhookSecretEnc String? @map("webhook_secret_enc") @db.Text // sin esto no se verifica la firma del webhook

  connectedAt DateTime @default(now()) @map("connected_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("whatsapp_settings")
}

/// Un cliente identificado por su teléfono de WhatsApp. Independiente de
/// `Rental` (que denormaliza los datos del cliente por alquiler): permite ver
/// la conversación de una persona a través de varios alquileres sin tocar el
/// modelo de Rental, ya extenso y con lógica crítica de facturación/evidencia
/// legal. El cruce con reservas existentes se hace en vivo por teléfono
/// (best-effort, ver src/lib/whatsapp/conversations.ts), sin FK.
model Customer {
  id String @id @default(cuid())

  phone String  @unique // E.164, ej. +5492611234567
  name  String?
  email String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  conversations WhatsAppConversation[]

  @@map("customers")
}

/// Una conversación por número de teléfono. `lastInboundAt` es el ancla de
/// la ventana de 24hs de Meta: pasado ese lapso sin que el cliente escriba,
/// solo se puede retomar mandando una plantilla aprobada.
model WhatsAppConversation {
  id String @id @default(cuid())

  phoneE164 String @unique @map("phone_e164")

  customerId String?   @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id])

  // Vínculo manual a la reserva de la que trata esta conversación — a
  // diferencia de `findRelatedRentals` (coincidencia automática por
  // teléfono, siempre en vivo, nunca persistida), esto es una elección
  // explícita del equipo, útil cuando el cliente escribe desde otro número
  // o cuando hay varias reservas candidatas y hace falta desambiguar.
  rentalId String? @map("rental_id")
  rental   Rental? @relation(fields: [rentalId], references: [id])

  assignedToId String? @map("assigned_to_id")
  assignedTo   User?   @relation(fields: [assignedToId], references: [id])

  lastMessageAt  DateTime? @map("last_message_at")
  lastInboundAt  DateTime? @map("last_inbound_at")
  // Última salida en cualquier dirección: desde Andes, el bot, o un eco de
  // la app/WhatsApp Web (Coexistence, ver WhatsAppMessage.sentViaApp).
  lastOutboundAt DateTime? @map("last_outbound_at")
  // Última vez que alguien del equipo abrió este hilo en Andes (ver
  // markConversationRead). Junto con lastOutboundAt define "pendiente de
  // respuesta": ver needsReply en src/lib/whatsapp/conversations.ts.
  lastReadAt     DateTime? @map("last_read_at")

  // El bot responde mientras esté true. Se apaga solo al escalar a un
  // humano (ver WhatsAppBotEscalation) o a mano desde el hilo.
  botEnabled Boolean @default(true) @map("bot_enabled")

  // Fijado propio de Andes (no es un espejo de "pinear" en WhatsApp — esa
  // función vive en el protocolo del teléfono/multi-dispositivo y Meta no la
  // expone por webhook, ver docs/wordpress-mapping.md-style nota en
  // CLAUDE.md). Compartido para todo el equipo, no por usuario. Timestamp
  // (no boolean) para poder ordenar las fijadas entre sí; null = no fijada.
  pinnedAt DateTime? @map("pinned_at")

  // Estados de triage sobre "no leído"/"leído", ver conversationState() en
  // src/lib/whatsapp/conversations.ts. El bot los prende solo (campo
  // `outcome` de la tool `respond`, ver whatsapp/bot/reply.ts) y también se
  // pueden prender/apagar a mano desde el hilo.

  // "A confirmar": el cliente acaba de aceptar una propuesta concreta y
  // falta que un humano arme la reserva. Se resuelve solo (deja de contar)
  // en cuanto esta conversación queda vinculada a una reserva (`rentalId`).
  pendingConfirmationAt DateTime? @map("pending_confirmation_at")

  // "A recuperar": se cotizó (completo o de referencia) y el cliente quedó
  // en responder después. Se resuelve solo apenas el cliente vuelve a
  // escribir (`lastInboundAt` más nuevo que esto) o al vincular una reserva.
  followUpAt DateTime? @map("follow_up_at")

  // "Confirmado": marcado a mano — a diferencia de los dos de arriba, este
  // nunca lo prende el bot ni se resuelve solo. Pensado para clientes
  // frecuentes: ya está todo arreglado con esa persona (con o sin una
  // reserva puntual vinculada en Andes) y no hace falta que siga apareciendo
  // como "a recuperar". Prenderlo también limpia `pendingConfirmationAt`/
  // `followUpAt` (mismo criterio que vincular una reserva).
  confirmedAt DateTime? @map("confirmed_at")

  // "Transferido": el bot escaló porque no estaba seguro (ver
  // WhatsAppBotEscalation, mismo evento). Se resuelve solo apenas hay una
  // salida (humano, o el bot si lo reactivan) más nueva que esto, o al
  // vincular una reserva.
  transferredAt DateTime? @map("transferred_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  messages     WhatsAppMessage[]
  escalations  WhatsAppBotEscalation[]
  rentalQuotes RentalQuote[]

  @@index([lastMessageAt])
  @@index([customerId])
  @@index([assignedToId])
  @@index([rentalId])
  @@map("whatsapp_conversations")
}

/// Un mensaje individual, entrante o saliente. `waMessageId` es el id que
/// asigna Meta/Chakra — único, evita duplicar un mensaje si el webhook
/// reintenta la misma entrega.
model WhatsAppMessage {
  id String @id @default(cuid())

  conversationId String               @map("conversation_id")
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id])

  waMessageId String?           @unique @map("wa_message_id")
  direction   WhatsAppDirection

  // Solo en salientes: quién lo mandó desde Andes. Null en entrantes (los
  // manda el cliente, no un User). `sentByName` congela el nombre (ver
  // Inspection.userName) — sobrevive a que se borre el usuario.
  sentById   String? @map("sent_by_id")
  sentBy     User?   @relation(fields: [sentById], references: [id])
  sentByName String? @map("sent_by_name")

  body String? @db.Text

  mediaId String?        @unique @map("media_id")
  media   WhatsAppMedia? @relation(fields: [mediaId], references: [id])

  // Si el mensaje reabrió la conversación con una plantilla aprobada (lo
  // único que Meta factura como "conversación iniciada por el negocio").
  viaTemplate  Boolean @default(false) @map("via_template")
  templateName String? @map("template_name")

  // Distingue una respuesta automática del bot de una escrita por el
  // equipo — ambas comparten `direction: out` y `sentById: null`.
  sentByBot Boolean @default(false) @map("sent_by_bot")

  // Mandado a mano desde la app de WhatsApp Business o WhatsApp Web
  // vinculado al mismo número (Coexistence), no desde Andes — llega como
  // eco del webhook de Meta, no por una acción del equipo acá. También
  // `direction: out` y `sentById: null`.
  sentViaApp Boolean @default(false) @map("sent_via_app")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@map("whatsapp_messages")
}

/// Adjunto multimedia de un mensaje. Los bytes viven en el storage
/// compartido de la app (R2/local, ver src/lib/storage.ts) bajo `storageKey`
/// — no hace falta un almacenamiento dual propio, Andes ya resuelve
/// R2-vs-local en un solo lugar.
model WhatsAppMedia {
  id String @id @default(uuid()) // no adivinable: se sirve por esta id sin sesión

  storageKey String            @map("storage_key")
  mimeType   String            @map("mime_type")
  kind       WhatsAppMediaKind

  createdAt DateTime @default(now()) @map("created_at")

  message WhatsAppMessage?

  @@map("whatsapp_media")
}

/// Caché de solo lectura de las plantillas aprobadas en Meta/Chakra,
/// sincronizada a mano desde Configuración → WhatsApp. Es lo único que
/// permite retomar una conversación fuera de la ventana de 24hs.
model WhatsAppTemplate {
  id String @id @default(cuid())

  externalId String @unique @map("external_id") // id de Meta/Chakra
  name       String
  language   String
  status     String // valor crudo de Meta: APPROVED | PENDING | REJECTED | ...
  bodyText   String @map("body_text") @db.Text

  variableCount Int @default(0) @map("variable_count")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("whatsapp_templates")
}

/// Configuración del bot de IA que responde automáticamente en WhatsApp.
/// Singleton id = 1, mismo patrón que el resto de las settings de la app.
model WhatsAppBotConfig {
  id Int @id @default(1)

  enabled              Boolean @default(false)
  prompt               String  @default("") @db.Text
  onlyNewConversations Boolean @default(false) @map("only_new_conversations") // deja de responder apenas un humano contesta esa conversación

  // Teléfonos (E.164) que ignoran `onlyNewConversations`: el bot les sigue
  // respondiendo aunque un humano ya haya escrito en esa conversación — para
  // poder probar/entrenar el bot desde un número propio sin tener que
  // prender/apagarlo para toda la cuenta.
  trainingPhones Json @default("[]") @map("training_phones")

  // Políticas fijas del negocio como lista de { topic, text } — separadas del
  // `prompt` de personalidad a propósito: el dueño no usa `WhatsAppBotDocument`
  // y quiere poder ir directo a actualizar un tema puntual (ej. "Cruce a
  // Chile") sin releer todo el prompt de comportamiento.
  policies Json @default("[]")

  // Doble capa de seguridad (instrucción al modelo + chequeo programático):
  // `escalationWords` se revisan ANTES de llamar a Claude contra el último
  // mensaje del cliente (deriva directo, sin gastar el llamado);
  // `blockedWords` se revisan DESPUÉS contra la respuesta generada (1
  // reintento pidiendo reformular, si persiste se escala).
  blockedWords    Json @default("[]") @map("blocked_words")
  escalationWords Json @default("[]") @map("escalation_words")

  // Ejemplos few-shot { question, answer } — guían tono/estilo, no son
  // respuestas fijas a copiar literal.
  examples Json @default("[]")

  handoffMessage String? @map("handoff_message") @db.Text

  // Días sin que el cliente responda desde que una conversación queda "A
  // recuperar" (ver conversationState en whatsapp/conversations.ts) para
  // marcarla como vencida en el listado — solo cambia cómo se destaca, no el
  // criterio de cuándo entra a ese estado (eso lo decide el bot al instante,
  // vía el outcome de la tool `respond`).
  followUpStaleDays Int @default(3) @map("follow_up_stale_days")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("whatsapp_bot_config")
}

/// Documento de la base de conocimiento del bot (PDF/DOCX/TXT). El texto se
/// extrae una sola vez al subir y es lo que se inyecta al prompt —
/// contexto simple concatenado, no RAG con embeddings (alcanza para pocos
/// documentos tipo brochure/FAQ, sin la infraestructura que requeriría RAG
/// real si el volumen creciera mucho).
model WhatsAppBotDocument {
  id String @id @default(cuid())

  fileName  String @map("file_name")
  mimeType  String @map("mime_type")
  sizeBytes Int    @map("size_bytes")

  storageKey String @map("storage_key") // bytes originales, mismo storage() que el resto de la app

  extractedText String  @map("extracted_text") @db.Text
  truncated     Boolean @default(false) // se cortó a lo bruto (fallback si el resumen con IA también falló/se pasó)
  summarized    Boolean @default(false) // se resumió con IA porque el texto extraído superaba el tope

  createdAt DateTime @default(now()) @map("created_at")

  @@map("whatsapp_bot_documents")
}

/// Registro de cada vez que el bot pasó una conversación a un humano —
/// panel de calidad para revisar casos reales en vez de ajustar el prompt a
/// ciegas.
model WhatsAppBotEscalation {
  id String @id @default(cuid())

  conversationId String               @map("conversation_id")
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id])

  trigger       String // 'confidence' | 'escalation_word' | 'blocked_word'
  reason        String? @db.Text
  clientMessage String? @map("client_message") @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  // Revisión del dueño: qué debería haber respondido el bot en este caso, y
  // si esa respuesta se usó para crear un ejemplo (WhatsAppBotConfig.examples)
  // que lo entrena para la próxima vez. `resolvedAt` null = todavía sin revisar.
  correctAnswer  String?   @map("correct_answer") @db.Text
  addedAsExample Boolean   @default(false) @map("added_as_example")
  resolvedAt     DateTime? @map("resolved_at")
  resolvedById   String?   @map("resolved_by_id")
  resolvedBy     User?     @relation("WhatsAppBotEscalationResolver", fields: [resolvedById], references: [id])
  resolvedByName String?   @map("resolved_by_name")

  @@index([conversationId])
  @@map("whatsapp_bot_escalations")
}

/// Valor de referencia del USD en pesos (Caja). Historial append-only: editar
/// el valor agrega una fila nueva, nunca pisa la anterior — así cada movimiento
/// en USD se convierte a ARS (Reportes) con el valor vigente cuando se cargó
/// (ver `usdRateAt` en `src/lib/usd-rate.ts`). Sin FK a `User` a propósito:
/// alcanza con el nombre congelado (mismo criterio que el resto de la auditoría).
model UsdRate {
  id String @id @default(cuid())

  /// Pesos por 1 USD.
  rate Decimal @db.Decimal(12, 2)

  createdByName String   @map("created_by_name")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("usd_rates")
}

/// Traspaso de saldo entre dos cuentas propias (Saldos): mueve plata de una a
/// otra sin ser ingreso ni egreso — por eso vive aparte de `CashMovement` (no
/// entra en Movimientos, totales del período ni Reportes; solo en los saldos
/// de cada cuenta y, si alguna es `isCash`, en la Billetera). Con monedas
/// distintas (ARS ↔ USD) `fromAmount`/`toAmount` son dos montos: la cotización
/// implícita es la de esa operación. Inmutable: no se edita, si está mal se
/// elimina (soft delete con motivo) y se vuelve a cargar. Sin FK a `User`:
/// alcanza con el nombre congelado (mismo criterio que `UsdRate`).
model AccountTransfer {
  id String @id @default(cuid())

  // Cuenta origen/destino nula = la Caja fuerte (efectivo físico, ver
  // `src/lib/safe.ts`) — no es un `PaymentMethod`. Nunca ambas nulas (se valida
  // en `createAccountTransfer`).
  fromAccountId   String?        @map("from_account_id")
  fromAccount     PaymentMethod? @relation("AccountTransferFrom", fields: [fromAccountId], references: [id])
  fromAccountName String         @map("from_account_name")
  fromAmount      Decimal        @map("from_amount") @db.Decimal(12, 2)
  fromCurrency    Currency       @map("from_currency")

  toAccountId   String?        @map("to_account_id")
  toAccount     PaymentMethod? @relation("AccountTransferTo", fields: [toAccountId], references: [id])
  toAccountName String         @map("to_account_name")
  toAmount      Decimal       @map("to_amount") @db.Decimal(12, 2)
  toCurrency    Currency      @map("to_currency")

  description String @default("") @db.Text

  createdByName String   @map("created_by_name")
  createdAt     DateTime @default(now()) @map("created_at")

  deletedAt     DateTime? @map("deleted_at")
  deletedByName String?   @map("deleted_by_name")
  deleteNote    String?   @map("delete_note") @db.Text

  @@index([createdAt])
  @@index([fromAccountId])
  @@index([toAccountId])
  @@map("account_transfers")
}
